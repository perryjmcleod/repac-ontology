<?xml version="1.0"?>
<rdf:RDF
    xmlns="https://perryjmcleod.github.io/repac-ontology/ontology#"
    xml:base="https://perryjmcleod.github.io/repac-ontology/ontology"
    xmlns:repac="https://perryjmcleod.github.io/repac-ontology/ontology#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <!-- ===================================================== -->
    <!-- Ontology declaration                                  -->
    <!-- ===================================================== -->

    <owl:Ontology rdf:about="https://perryjmcleod.github.io/repac-ontology/ontology/repac-value">
        <owl:versionIRI rdf:resource="https://perryjmcleod.github.io/repac-ontology/ontology/v1.0/repac-value"/>
        <owl:imports rdf:resource="https://perryjmcleod.github.io/repac-ontology/ontology/repac-core"/>
        <rdfs:label>REPAC Ontology – Value Superset</rdfs:label>
        <rdfs:comment>
            Defines the Value superset within the REPAC ontology.
            Value models realized benefit or impact resulting from work,
            independent of intent (Purpose) or execution (Work).
        </rdfs:comment>
    </owl:Ontology>

    <!-- ===================================================== -->
    <!-- Superset: Value                                       -->
    <!-- ===================================================== -->

    <repac:Superset rdf:about="#Value">
        <repac:repacId>REPAC-TL-S9</repac:repacId>
        <repac:name>Value</repac:name>
        <repac:description>
            The benefit or impact realized as a result of work.
        </repac:description>
        <repac:longDescription>
            Value represents the effects or benefits that are realized
            after work is performed. It does not assert intent, motivation,
            or execution method, and may be realized intentionally or
            unintentionally.
        </repac:longDescription>
    </repac:Superset>

    <!-- ===================================================== -->
    <!-- Subset: Tangible Value                                -->
    <!-- ===================================================== -->

    <repac:Subset rdf:about="#TangibleValue">
        <repac:repacId>REPAC-VAL-SS1</repac:repacId>
        <repac:name>Tangible Value</repac:name>
        <repac:description>
            Value that can be directly measured or observed.
        </repac:description>
        <repac:longDescription>
            Tangible Value includes measurable outcomes such as
            financial gain, cost reduction, throughput improvement,
            or physical deliverables.
        </repac:longDescription>
        <repac:partOf rdf:resource="#Value"/>
    </repac:Subset>

    <!-- ===================================================== -->
    <!-- Subset: Intangible Value                              -->
    <!-- ===================================================== -->

    <repac:Subset rdf:about="#IntangibleValue">
        <repac:repacId>REPAC-VAL-SS2</repac:repacId>
        <repac:name>Intangible Value</repac:name>
        <repac:description>
            Value that is realized indirectly or subjectively.
        </repac:description>
        <repac:longDescription>
            Intangible Value includes benefits such as trust,
            reputation, satisfaction, capability development,
            or risk reduction that may not be directly quantifiable.
        </repac:longDescription>
        <repac:partOf rdf:resource="#Value"/>
    </repac:Subset>

</rdf:RDF>
