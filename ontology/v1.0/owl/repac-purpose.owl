<?xml version="1.0"?>
<rdf:RDF
    xmlns="https://perryjmcleod.github.io/repac-ontology/ontology#"
    xml:base="https://perryjmcleod.github.io/repac-ontology/ontology"
    xmlns:repac="https://perryjmcleod.github.io/repac-ontology/ontology#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <!-- ===================================================== -->
    <!-- Ontology declaration                                 -->
    <!-- ===================================================== -->

    <owl:Ontology rdf:about="https://perryjmcleod.github.io/repac-ontology/ontology/repac-purpose">
        <owl:versionIRI rdf:resource="https://perryjmcleod.github.io/repac-ontology/ontology/v1.0/repac-purpose"/>
        <owl:imports rdf:resource="https://perryjmcleod.github.io/repac-ontology/ontology/repac-core"/>
        <rdfs:label>REPAC Ontology – Purpose Superset</rdfs:label>
        <rdfs:comment>
            Defines the Purpose superset within the REPAC ontology.
            Purpose models why work is undertaken, independent of
            value realization or motivational framing.
        </rdfs:comment>
    </owl:Ontology>

    <!-- ===================================================== -->
    <!-- Superset: Purpose                                     -->
    <!-- ===================================================== -->

    <repac:Superset rdf:about="#Purpose">
        <repac:repacId>REPAC-TL-S1</repac:repacId>
        <repac:name>Purpose</repac:name>
        <repac:description>
            The explicit or implicit reason why work is undertaken.
        </repac:description>
        <repac:longDescription>
            Purpose establishes the intent or rationale that gives
            direction to work. It answers why an activity exists
            without asserting how it will be executed or what value
            will ultimately be realized.
        </repac:longDescription>
    </repac:Superset>

    <!-- ===================================================== -->
    <!-- Subset: Intentional Purpose                           -->
    <!-- ===================================================== -->

    <repac:Subset rdf:about="#IntentionalPurpose">
        <repac:repacId>REPAC-PUR-SS1</repac:repacId>
        <repac:name>Intentional Purpose</repac:name>
        <repac:description>
            Purpose that is consciously defined and articulated.
        </repac:description>
        <repac:longDescription>
            Intentional Purpose represents explicitly stated aims,
            objectives, or goals that are deliberately set by
            individuals or organizations to guide action.
        </repac:longDescription>
        <repac:partOf rdf:resource="#Purpose"/>
    </repac:Subset>

    <!-- ===================================================== -->
    <!-- Subset: Declarative Purpose                           -->
    <!-- ===================================================== -->

    <repac:Subset rdf:about="#DeclarativePurpose">
        <repac:repacId>REPAC-PUR-SS2</repac:repacId>
        <repac:name>Declarative Purpose</repac:name>
        <repac:description>
            Purpose inferred or stated as a condition of existence.
        </repac:description>
        <repac:longDescription>
            Declarative Purpose represents purpose that is expressed
            through mandates, charters, policies, or contextual
            conditions, rather than through explicit intention.
        </repac:longDescription>
        <repac:partOf rdf:resource="#Purpose"/>
    </repac:Subset>

</rdf:RDF>
