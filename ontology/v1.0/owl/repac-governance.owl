<?xml version="1.0"?>
<rdf:RDF
    xmlns="https://perryjmcleod.github.io/repac-ontology/ontology#"
    xml:base="https://perryjmcleod.github.io/repac-ontology/ontology"
    xmlns:repac="https://perryjmcleod.github.io/repac-ontology/ontology#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <!-- ===================================================== -->
    <!-- Ontology declaration                                  -->
    <!-- ===================================================== -->

    <owl:Ontology rdf:about="https://perryjmcleod.github.io/repac-ontology/ontology/repac-governance">
        <owl:versionIRI rdf:resource="https://perryjmcleod.github.io/repac-ontology/ontology/v1.0/repac-governance"/>
        <owl:imports rdf:resource="https://perryjmcleod.github.io/repac-ontology/ontology/repac-core"/>
        <rdfs:label>REPAC Ontology – Governance Superset</rdfs:label>
        <rdfs:comment>
            Defines the Governance superset within the REPAC ontology.
            Governance models authority, oversight, and decision control
            applied to work and value realization.
        </rdfs:comment>
    </owl:Ontology>

    <!-- ===================================================== -->
    <!-- Superset: Governance                                  -->
    <!-- ===================================================== -->

    <repac:Superset rdf:about="#Governance">
        <repac:repacId>REPAC-TL-S10</repac:repacId>
        <repac:name>Governance</repac:name>
        <repac:description>
            The structures and authorities that direct and control work.
        </repac:description>
        <repac:longDescription>
            Governance establishes who has the authority to decide,
            approve, constrain, or halt work, and how accountability
            is enforced. It does not perform work; it constrains and
            oversees it.
        </repac:longDescription>
    </repac:Superset>

    <!-- ===================================================== -->
    <!-- Subset: Strategic Governance                          -->
    <!-- ===================================================== -->

    <repac:Subset rdf:about="#StrategicGovernance">
        <repac:repacId>REPAC-GOV-SS1</repac:repacId>
        <repac:name>Strategic Governance</repac:name>
        <repac:description>
            Governance that sets direction and long-term constraints.
        </repac:description>
        <repac:longDescription>
            Strategic Governance includes decision authority related
            to purpose alignment, prioritization, funding boundaries,
            and long-term oversight.
        </repac:longDescription>
        <repac:partOf rdf:resource="#Governance"/>
    </repac:Subset>

    <!-- ===================================================== -->
    <!-- Subset: Operational Governance                        -->
    <!-- ===================================================== -->

    <repac:Subset rdf:about="#OperationalGovernance">
        <repac:repacId>REPAC-GOV-SS2</repac:repacId>
        <repac:name>Operational Governance</repac:name>
        <repac:description>
            Governance that controls execution and compliance.
        </repac:description>
        <repac:longDescription>
            Operational Governance includes approval gates,
            standards enforcement, risk controls, and escalation
            mechanisms applied during execution.
        </repac:longDescription>
        <repac:partOf rdf:resource="#Governance"/>
    </repac:Subset>

</rdf:RDF>
