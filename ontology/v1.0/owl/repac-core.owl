<?xml version="1.0"?>
<rdf:RDF xmlns="https://repac.org/ontology#"
     xml:base="https://repac.org/ontology/repac-core"
     xmlns:repac="https://repac.org/ontology#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dcterms="http://purl.org/dc/terms/">

    <!-- ############################################################ -->
    <!-- Ontology                                                     -->
    <!-- ############################################################ -->

    <owl:Ontology rdf:about="https://repac.org/ontology/repac-core">
        <owl:versionIRI rdf:resource="https://repac.org/ontology/v1.0/repac-core"/>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0.0</owl:versionInfo>
        <rdfs:label xml:lang="en">REPAC Core Ontology</rdfs:label>
        <rdfs:comment xml:lang="en">Core classes, properties, and annotations shared by all REPAC superset modules. Superset modules import this ontology.</rdfs:comment>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:publisher xml:lang="en">REPAC Ontology Project</dcterms:publisher>
    </owl:Ontology>

    <!-- ############################################################ -->
    <!-- Annotation Properties                                        -->
    <!-- ############################################################ -->

    <owl:AnnotationProperty rdf:about="https://repac.org/ontology#repacId">
        <rdfs:label xml:lang="en">repacId</rdfs:label>
        <rdfs:comment xml:lang="en">Stable identifier used in diagrams and artifact alignment (e.g., REPAC-TL-S1).</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="https://repac.org/ontology#name">
        <rdfs:label xml:lang="en">name</rdfs:label>
        <rdfs:comment xml:lang="en">Human-readable name.</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="https://repac.org/ontology#description">
        <rdfs:label xml:lang="en">description</rdfs:label>
        <rdfs:comment xml:lang="en">Short definition suitable for tooltips and compact renderings.</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="https://repac.org/ontology#longDescription">
        <rdfs:label xml:lang="en">longDescription</rdfs:label>
        <rdfs:comment xml:lang="en">Extended definition capturing boundary language, exclusions, and usage guidance.</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="https://repac.org/ontology#status">
        <rdfs:label xml:lang="en">status</rdfs:label>
        <rdfs:comment xml:lang="en">Lifecycle status (e.g., draft, locked, deprecated).</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="https://repac.org/ontology#sourceNote">
        <rdfs:label xml:lang="en">sourceNote</rdfs:label>
        <rdfs:comment xml:lang="en">Provenance or editorial note (not the REPAC 'Source' superset).</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- ############################################################ -->
    <!-- Core Classes                                                 -->
    <!-- ############################################################ -->

    <owl:Class rdf:about="https://repac.org/ontology#RepacEntity">
        <rdfs:label xml:lang="en">REPAC Entity</rdfs:label>
        <rdfs:comment xml:lang="en">A first-class modeling construct in the REPAC ontology.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://repac.org/ontology#Superset">
        <rdfs:subClassOf rdf:resource="https://repac.org/ontology#RepacEntity"/>
        <rdfs:label xml:lang="en">Superset</rdfs:label>
        <rdfs:comment xml:lang="en">Top-level analytical family (e.g., Purpose, Scope, Work) that organizes related subsets, sets, and elements.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://repac.org/ontology#Subset">
        <rdfs:subClassOf rdf:resource="https://repac.org/ontology#RepacEntity"/>
        <rdfs:label xml:lang="en">Subset</rdfs:label>
        <rdfs:comment xml:lang="en">Second-level grouping within a Superset.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://repac.org/ontology#Set">
        <rdfs:subClassOf rdf:resource="https://repac.org/ontology#RepacEntity"/>
        <rdfs:label xml:lang="en">Set</rdfs:label>
        <rdfs:comment xml:lang="en">Third-level grouping used to organize elements.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://repac.org/ontology#Element">
        <rdfs:subClassOf rdf:resource="https://repac.org/ontology#RepacEntity"/>
        <rdfs:label xml:lang="en">Element</rdfs:label>
        <rdfs:comment xml:lang="en">Atomic analytical construct in REPAC, used in reasoning and application.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://repac.org/ontology#Lens">
        <rdfs:subClassOf rdf:resource="https://repac.org/ontology#RepacEntity"/>
        <rdfs:label xml:lang="en">Lens</rdfs:label>
        <rdfs:comment xml:lang="en">A modifier construct used to view or constrain analysis without being treated as a Source subset. Lenses are generally modeled under Scope when applicable.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://repac.org/ontology#ScopeLens">
        <rdfs:subClassOf rdf:resource="https://repac.org/ontology#Lens"/>
        <rdfs:label xml:lang="en">Scope Lens</rdfs:label>
        <rdfs:comment xml:lang="en">A lens that constrains analysis by scope framing (e.g., Internal Source and External Source).</rdfs:comment>
    </owl:Class>

    <!-- ############################################################ -->
    <!-- Core Object Properties                                       -->
    <!-- ############################################################ -->

    <owl:ObjectProperty rdf:about="https://repac.org/ontology#hasSubset">
        <rdfs:label xml:lang="en">has subset</rdfs:label>
        <rdfs:domain rdf:resource="https://repac.org/ontology#Superset"/>
        <rdfs:range rdf:resource="https://repac.org/ontology#Subset"/>
        <rdfs:comment xml:lang="en">Relates a Superset to its Subsets.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://repac.org/ontology#hasSet">
        <rdfs:label xml:lang="en">has set</rdfs:label>
        <rdfs:domain rdf:resource="https://repac.org/ontology#Subset"/>
        <rdfs:range rdf:resource="https://repac.org/ontology#Set"/>
        <rdfs:comment xml:lang="en">Relates a Subset to its Sets.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://repac.org/ontology#hasElement">
        <rdfs:label xml:lang="en">has element</rdfs:label>
        <rdfs:domain rdf:resource="https://repac.org/ontology#Set"/>
        <rdfs:range rdf:resource="https://repac.org/ontology#Element"/>
        <rdfs:comment xml:lang="en">Relates a Set to its Elements.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://repac.org/ontology#partOf">
        <rdfs:label xml:lang="en">part of</rdfs:label>
        <rdfs:comment xml:lang="en">Generic containment relationship. Prefer hasSubset/hasSet/hasElement for structured hierarchy; use partOf for cross-cutting composition.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://repac.org/ontology#usesLens">
        <rdfs:label xml:lang="en">uses lens</rdfs:label>
        <rdfs:domain rdf:resource="https://repac.org/ontology#RepacEntity"/>
        <rdfs:range rdf:resource="https://repac.org/ontology#Lens"/>
        <rdfs:comment xml:lang="en">Indicates an entity is analyzed through or constrained by a lens.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ############################################################ -->
    <!-- Core Data Properties                                         -->
    <!-- ############################################################ -->

    <owl:DatatypeProperty rdf:about="https://repac.org/ontology#rank">
        <rdfs:label xml:lang="en">rank</rdfs:label>
        <rdfs:domain rdf:resource="https://repac.org/ontology#RepacEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Optional ordering hint for UI rendering and documentation generation.</rdfs:comment>
    </owl:DatatypeProperty>

</rdf:RDF>
