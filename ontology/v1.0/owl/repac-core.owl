<?xml version="1.0"?>
<rdf:RDF
    xmlns="https://perryjmcleod.github.io/repac-ontology/ontology#"
    xml:base="https://perryjmcleod.github.io/repac-ontology/ontology"
    xmlns:repac="https://perryjmcleod.github.io/repac-ontology/ontology#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="https://perryjmcleod.github.io/repac-ontology/ontology/repac-core">
        <owl:versionIRI rdf:resource="https://perryjmcleod.github.io/repac-ontology/ontology/v1.0/repac-core"/>
        <rdfs:label>REPAC Ontology – Core</rdfs:label>
        <rdfs:comment>
            Core classes, properties, and annotations shared across all REPAC ontology modules.
        </rdfs:comment>
    </owl:Ontology>

    <!-- Core structural classes -->

    <owl:Class rdf:about="#RepacEntity"/>
    <owl:Class rdf:about="#Superset">
        <rdfs:subClassOf rdf:resource="#RepacEntity"/>
    </owl:Class>
    <owl:Class rdf:about="#Subset">
        <rdfs:subClassOf rdf:resource="#RepacEntity"/>
    </owl:Class>
    <owl:Class rdf:about="#Set">
        <rdfs:subClassOf rdf:resource="#RepacEntity"/>
    </owl:Class>
    <owl:Class rdf:about="#Element">
        <rdfs:subClassOf rdf:resource="#RepacEntity"/>
    </owl:Class>

    <!-- Lenses -->

    <owl:Class rdf:about="#Lens">
        <rdfs:subClassOf rdf:resource="#RepacEntity"/>
    </owl:Class>

    <owl:Class rdf:about="#ScopeLens">
        <rdfs:subClassOf rdf:resource="#Lens"/>
    </owl:Class>

    <!-- Object properties -->

    <owl:ObjectProperty rdf:about="#partOf"/>
    <owl:ObjectProperty rdf:about="#hasSubset"/>
    <owl:ObjectProperty rdf:about="#hasSet"/>
    <owl:ObjectProperty rdf:about="#hasElement"/>
    <owl:ObjectProperty rdf:about="#usesLens"/>

    <!-- Annotation properties -->

    <owl:AnnotationProperty rdf:about="#repacId"/>
    <owl:AnnotationProperty rdf:about="#name"/>
    <owl:AnnotationProperty rdf:about="#description"/>
    <owl:AnnotationProperty rdf:about="#longDescription"/>
    <owl:AnnotationProperty rdf:about="#status"/>
    <owl:AnnotationProperty rdf:about="#sourceNote"/>

    <!-- Data properties -->

    <owl:DatatypeProperty rdf:about="#rank">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

</rdf:RDF>
