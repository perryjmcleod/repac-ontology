<?xml version="1.0"?>
<rdf:RDF
    xmlns="https://perryjmcleod.github.io/repac-ontology/ontology#"
    xml:base="https://perryjmcleod.github.io/repac-ontology/ontology"
    xmlns:repac="https://perryjmcleod.github.io/repac-ontology/ontology#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <!-- ===================================================== -->
    <!-- Ontology declaration                                  -->
    <!-- ===================================================== -->

    <owl:Ontology rdf:about="https://perryjmcleod.github.io/repac-ontology/ontology/repac-collaboration">
        <owl:versionIRI rdf:resource="https://perryjmcleod.github.io/repac-ontology/ontology/v1.0/repac-collaboration"/>
        <owl:imports rdf:resource="https://perryjmcleod.github.io/repac-ontology/ontology/repac-core"/>
        <rdfs:label>REPAC Ontology – Collaboration Superset</rdfs:label>
        <rdfs:comment>
            Defines the Collaboration superset within the REPAC ontology.
            Collaboration models how actors coordinate and work together
            toward shared or interdependent outcomes.
        </rdfs:comment>
    </owl:Ontology>

    <!-- ===================================================== -->
    <!-- Superset: Collaboration                               -->
    <!-- ===================================================== -->

    <repac:Superset rdf:about="#Collaboration">
        <repac:repacId>REPAC-TL-S11</repac:repacId>
        <repac:name>Collaboration</repac:name>
        <repac:description>
            The way in which actors coordinate effort and responsibility.
        </repac:description>
        <repac:longDescription>
            Collaboration characterizes patterns of coordination,
            interdependence, and joint effort among actors.
            It does not specify communication mechanisms or
            decision authority.
        </repac:longDescription>
    </repac:Superset>

    <!-- ===================================================== -->
    <!-- Subset: Coordinated Collaboration                     -->
    <!-- ===================================================== -->

    <repac:Subset rdf:about="#CoordinatedCollaboration">
        <repac:repacId>REPAC-COL-SS1</repac:repacId>
        <repac:name>Coordinated Collaboration</repac:name>
        <repac:description>
            Collaboration based on defined roles and planned coordination.
        </repac:description>
        <repac:longDescription>
            Coordinated Collaboration includes structured interaction
            where responsibilities, dependencies, and coordination
            mechanisms are explicitly defined.
        </repac:longDescription>
        <repac:partOf rdf:resource="#Collaboration"/>
    </repac:Subset>

    <!-- ===================================================== -->
    <!-- Subset: Emergent Collaboration                        -->
    <!-- ===================================================== -->

    <repac:Subset rdf:about="#EmergentCollaboration">
        <repac:repacId>REPAC-COL-SS2</repac:repacId>
        <repac:name>Emergent Collaboration</repac:name>
        <repac:description>
            Collaboration that arises dynamically without formal structure.
        </repac:description>
        <repac:longDescription>
            Emergent Collaboration includes adaptive, informal, or
            self-organizing interaction that develops in response
            to situational needs.
        </repac:longDescription>
        <repac:partOf rdf:resource="#Collaboration"/>
    </repac:Subset>

</rdf:RDF>
