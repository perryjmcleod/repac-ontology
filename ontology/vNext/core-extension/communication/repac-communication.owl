<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/repac/ontology/vNext/core-extension/communication#"
     xml:base="https://w3id.org/repac/ontology/vNext/core-extension/communication"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="https://w3id.org/repac/ontology/vNext/core-extension/communication">
        <rdfs:label>REPAC vNext Communication Ontology</rdfs:label>
        <rdfs:comment>REPAC vNext Communication superset ontology. Models the Communication superset and its frozen L1 subsets using the canonical vNext class hierarchy pattern. Communication is treated as subset-terminal and non-element-bearing in the normalized vNext repository state.</rdfs:comment>
    </owl:Ontology>

    <owl:Class rdf:about="https://w3id.org/repac/ontology/vNext/core-extension/communication#Communication">
        <rdfs:label>Communication</rdfs:label>
        <rdfs:comment>The REPAC superset concerned with how meaning, information, signals, or messages are conveyed, expressed, or exchanged within an analytical or organizational setting.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://w3id.org/repac/ontology/vNext/core-extension/communication#COMM-SUBSET-01-formal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/repac/ontology/vNext/core-extension/communication#Communication"/>
        <rdfs:label>Formal</rdfs:label>
        <rdfs:comment>The Communication subset concerned with communication that is structured, recognized, documented, or governed through explicit channels, rules, or conventions.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://w3id.org/repac/ontology/vNext/core-extension/communication#COMM-SUBSET-02-informal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/repac/ontology/vNext/core-extension/communication#Communication"/>
        <rdfs:label>Informal</rdfs:label>
        <rdfs:comment>The Communication subset concerned with communication that arises outside formal channels or structures through spontaneous, social, or unofficial exchange.</rdfs:comment>
    </owl:Class>

</rdf:RDF>