<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/repac/vNext#"
     xml:base="http://example.org/repac/vNext#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="http://example.org/repac/vNext/core-extension/communication-l1">
    <rdfs:label xml:lang="en">REPAC vNext Communication L1 Structural Stub</rdfs:label>
    <rdfs:comment xml:lang="en">Structural stub only. Subset structure is frozen. No element modeling.</rdfs:comment>
  </owl:Ontology>

  <owl:Class rdf:about="http://example.org/repac/vNext#Communication">
    <rdfs:label xml:lang="en">Communication</rdfs:label>
    <rdfs:comment xml:lang="en">Top-level anchor for Communication in REPAC vNext.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/repac/vNext#FormalCommunication">
    <rdfs:label xml:lang="en">Formal Communication</rdfs:label>
    <rdfs:comment xml:lang="en">Frozen Communication L1 Subset. Structural anchor only.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/repac/vNext#Communication"/>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/repac/vNext#InformalCommunication">
    <rdfs:label xml:lang="en">Informal Communication</rdfs:label>
    <rdfs:comment xml:lang="en">Frozen Communication L1 Subset. Structural anchor only.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/repac/vNext#Communication"/>
  </owl:Class>

</rdf:RDF>