@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

@prefix repac: <http://example.org/repac/vNext#> .

<http://example.org/repac/vNext/core-extension/communication-l1>
  a owl:Ontology ;
  rdfs:label "REPAC vNext Communication L1 Structural Stub"@en ;
  rdfs:comment "Structural stub only. Subset structure is frozen. No element modeling."@en .

repac:Communication
  a owl:Class ;
  rdfs:label "Communication"@en ;
  rdfs:comment "Top-level anchor for Communication in REPAC vNext."@en .

repac:FormalCommunication
  a owl:Class ;
  rdfs:label "Formal Communication"@en ;
  rdfs:comment "Frozen Communication L1 Subset. Structural anchor only."@en ;
  rdfs:subClassOf repac:Communication .

repac:InformalCommunication
  a owl:Class ;
  rdfs:label "Informal Communication"@en ;
  rdfs:comment "Frozen Communication L1 Subset. Structural anchor only."@en ;
  rdfs:subClassOf repac:Communication .