<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/repac/ontology/vNext/core-extension/source#"
     xml:base="https://w3id.org/repac/ontology/vNext/core-extension/source"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="https://w3id.org/repac/ontology/vNext/core-extension/source">
        <rdfs:label>REPAC vNext Source Ontology</rdfs:label>
        <rdfs:comment>REPAC vNext Source superset ontology. Models the Source superset and its frozen L1 subsets using the canonical vNext class hierarchy pattern. Source is treated as subset-terminal and non-element-bearing in the normalized vNext repository state.</rdfs:comment>
    </owl:Ontology>

    <owl:Class rdf:about="https://w3id.org/repac/ontology/vNext/core-extension/source#Source">
        <rdfs:label>Source</rdfs:label>
        <rdfs:comment>The REPAC superset concerned with where something originates, is derived from, or is taken from within an analytical or organizational setting.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://w3id.org/repac/ontology/vNext/core-extension/source#SOURCE-SUBSET-01-internal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/repac/ontology/vNext/core-extension/source#Source"/>
        <rdfs:label>Internal</rdfs:label>
        <rdfs:comment>The Source subset concerned with sources arising from within the focal entity, boundary, or system under analysis.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://w3id.org/repac/ontology/vNext/core-extension/source#SOURCE-SUBSET-02-external">
        <rdfs:subClassOf rdf:resource="https://w3id.org/repac/ontology/vNext/core-extension/source#Source"/>
        <rdfs:label>External</rdfs:label>
        <rdfs:comment>The Source subset concerned with sources arising from outside the focal entity, boundary, or system under analysis.</rdfs:comment>
    </owl:Class>

</rdf:RDF>