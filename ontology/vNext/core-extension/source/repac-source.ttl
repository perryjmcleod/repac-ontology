@prefix : <https://w3id.org/repac/ontology/vNext/core-extension/source#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/repac/ontology/vNext/core-extension/source>
    rdf:type owl:Ontology ;
    rdfs:label "REPAC vNext Source Ontology" ;
    rdfs:comment "REPAC vNext Source superset ontology. Models the Source superset and its frozen L1 subsets using the canonical vNext class hierarchy pattern. Source is treated as subset-terminal and non-element-bearing in the normalized vNext repository state." .

:Source
    rdf:type owl:Class ;
    rdfs:label "Source" ;
    rdfs:comment "The REPAC superset concerned with where something originates, is derived from, or is taken from within an analytical or organizational setting." .

:SOURCE-SUBSET-01-internal
    rdf:type owl:Class ;
    rdfs:subClassOf :Source ;
    rdfs:label "Internal" ;
    rdfs:comment "The Source subset concerned with sources arising from within the focal entity, boundary, or system under analysis." .

:SOURCE-SUBSET-02-external
    rdf:type owl:Class ;
    rdfs:subClassOf :Source ;
    rdfs:label "External" ;
    rdfs:comment "The Source subset concerned with sources arising from outside the focal entity, boundary, or system under analysis." .