<!-- File: repac-scope.owl  (OWL/XML) -->
<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          xml:base="https://w3id.org/repac/ontology/scope#"
          ontologyIRI="https://w3id.org/repac/ontology/scope"
          xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
          xmlns:xml="http://www.w3.org/XML/1998/namespace"
          xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
          xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
          xmlns:dcterms="http://purl.org/dc/terms/"
          xmlns:skos="http://www.w3.org/2004/02/skos/core#"
          xmlns:repac="https://w3id.org/repac/ontology/core#">

  <Import>https://w3id.org/repac/ontology/core</Import>

  <Annotation>
    <AnnotationProperty abbreviatedIRI="dcterms:title"/>
    <Literal xml:lang="en">REPAC Scope L1</Literal>
  </Annotation>

  <Annotation>
    <AnnotationProperty abbreviatedIRI="dcterms:description"/>
    <Literal xml:lang="en">Structural stub for REPAC vNext: Scope (L1). Declares the Scope superset shell and L1 bridge properties. Non-prescriptive.</Literal>
  </Annotation>

  <Annotation>
    <AnnotationProperty IRI="http://www.w3.org/2002/07/owl#versionInfo"/>
    <Literal>vNext</Literal>
  </Annotation>

</Ontology>
