@prefix repac: <https://example.org/repac/vnext#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

repac:scope-l1-datagraph
  a owl:Ontology ;
  rdfs:label "REPAC vNext — Scope L1 DataGraph Wrapper"@en ;
  rdfs:comment "DataGraph integration wrapper for Scope L1. This ontology imports the authoritative Scope L1 structural stub to guarantee identical naming and IRIs."@en ;
  owl:imports <../scope-l1-structural-stub.ttl> .
