@prefix repac: <https://w3id.org/repac/ontology/vNext/core-extension/governance#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/repac/ontology/vNext/core-extension/governance>
    a owl:Ontology ;
    rdfs:label "REPAC vNext Governance Ontology"@en ;
    rdfs:comment "Governance superset population for REPAC vNext based on the authoritative L1 structural freeze."@en .

### Superset

repac:Governance
    a owl:Class ;
    rdfs:label "Governance"@en ;
    rdfs:comment "Top-level REPAC superset representing governance-related analytical structure."@en .

### Subsets

repac:Authority
    a owl:Class ;
    rdfs:subClassOf repac:Governance ;
    rdfs:label "Authority"@en ;
    rdfs:comment "Governance subset representing authority."@en .

repac:DecisionRights
    a owl:Class ;
    rdfs:subClassOf repac:Governance ;
    rdfs:label "Decision Rights"@en ;
    rdfs:comment "Governance subset representing decision rights."@en .

repac:Control
    a owl:Class ;
    rdfs:subClassOf repac:Governance ;
    rdfs:label "Control"@en ;
    rdfs:comment "Governance subset representing control."@en .

repac:Accountability
    a owl:Class ;
    rdfs:subClassOf repac:Governance ;
    rdfs:label "Accountability"@en ;
    rdfs:comment "Governance subset representing accountability."@en .

### Elements — Authority

repac:AuthorityStructure
    a owl:Class ;
    rdfs:subClassOf repac:Authority ;
    rdfs:label "Authority Structure"@en ;
    rdfs:comment "Governance element representing the structure through which authority is arranged or constituted."@en .

repac:LegitimacyBasis
    a owl:Class ;
    rdfs:subClassOf repac:Authority ;
    rdfs:label "Legitimacy Basis"@en ;
    rdfs:comment "Governance element representing the recognized basis on which authority or decision rights are accepted as valid."@en .

### Elements — Decision Rights

repac:DecisionRightsAllocation
    a owl:Class ;
    rdfs:subClassOf repac:DecisionRights ;
    rdfs:label "Decision Rights Allocation"@en ;
    rdfs:comment "Governance element representing how decision rights are distributed or assigned."@en .

repac:EscalationLogic
    a owl:Class ;
    rdfs:subClassOf repac:DecisionRights ;
    rdfs:label "Escalation Logic"@en ;
    rdfs:comment "Governance element representing the logic by which decisions, exceptions, or issues are escalated."@en .

### Elements — Control

repac:EnforcementMechanism
    a owl:Class ;
    rdfs:subClassOf repac:Control ;
    rdfs:label "Enforcement Mechanism"@en ;
    rdfs:comment "Governance element representing the means through which governance expectations are enforced."@en .

repac:ComplianceMechanism
    a owl:Class ;
    rdfs:subClassOf repac:Control ;
    rdfs:label "Compliance Mechanism"@en ;
    rdfs:comment "Governance element representing the means through which compliance is produced, monitored, or maintained."@en .

### Elements — Accountability

repac:OversightConstruct
    a owl:Class ;
    rdfs:subClassOf repac:Accountability ;
    rdfs:label "Oversight Construct"@en ;
    rdfs:comment "Governance element representing the structure or mechanism through which oversight is exercised."@en .

repac:InformalGovernanceOverlay
    a owl:Class ;
    rdfs:subClassOf repac:Accountability ;
    rdfs:label "Informal Governance Overlay"@en ;
    rdfs:comment "Governance element representing informal governance patterns that supplement, bypass, or reshape formal accountability arrangements."@en .