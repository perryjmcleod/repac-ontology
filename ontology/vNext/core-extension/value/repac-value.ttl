@prefix : <https://w3id.org/repac/ontology/vNext/core-extension/value#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/repac/ontology/vNext/core-extension/value>
    rdf:type owl:Ontology ;
    rdfs:label "REPAC vNext Value Ontology" ;
    rdfs:comment "REPAC vNext Value superset ontology. Models the Value superset and its frozen L1 subsets using the canonical vNext class hierarchy pattern. Value is treated as subset-terminal and non-element-bearing in the normalized vNext repository state." .

:Value
    rdf:type owl:Class ;
    rdfs:label "Value" ;
    rdfs:comment "The REPAC superset concerned with what is regarded as worth, significance, or importance within an analytical or organizational setting." .

:VAL-SUBSET-01-inherent
    rdf:type owl:Class ;
    rdfs:subClassOf :Value ;
    rdfs:label "Inherent" ;
    rdfs:comment "The Value subset concerned with value residing in the thing itself rather than being assigned through use, application, or external utility." .

:VAL-SUBSET-02-instrumental
    rdf:type owl:Class ;
    rdfs:subClassOf :Value ;
    rdfs:label "Instrumental" ;
    rdfs:comment "The Value subset concerned with value arising from use, function, effect, or utility relative to some end." .