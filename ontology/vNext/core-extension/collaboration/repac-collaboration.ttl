@prefix : <https://w3id.org/repac/ontology/vNext/core-extension/collaboration#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/repac/ontology/vNext/core-extension/collaboration>
    rdf:type owl:Ontology ;
    rdfs:label "REPAC vNext Collaboration Ontology" ;
    rdfs:comment "REPAC vNext Collaboration superset ontology. Models the Collaboration superset and its frozen L1 subsets using the canonical vNext class hierarchy pattern. Collaboration is treated as subset-terminal and non-element-bearing in the normalized vNext repository state." .

:Collaboration
    rdf:type owl:Class ;
    rdfs:label "Collaboration" ;
    rdfs:comment "The REPAC superset concerned with how actors work together, align effort, and participate jointly within an organizational or analytical setting." .

:COLLAB-SUBSET-01-coordinated
    rdf:type owl:Class ;
    rdfs:subClassOf :Collaboration ;
    rdfs:label "Coordinated" ;
    rdfs:comment "The Collaboration subset concerned with collaboration that is structured, organized, or intentionally aligned through explicit coordination." .

:COLLAB-SUBSET-02-emergent
    rdf:type owl:Class ;
    rdfs:subClassOf :Collaboration ;
    rdfs:label "Emergent" ;
    rdfs:comment "The Collaboration subset concerned with collaboration that arises dynamically through unfolding interaction, adaptation, or situational response rather than prior formal coordination." .