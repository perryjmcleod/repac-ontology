@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix repac: <https://repac.org/ontology#> .

#################################################################
# REPAC Ontology v1.0 — Minimal Structural SHACL Shapes
#
# These shapes provide structural sanity validation only.
# They do not encode behavioral, procedural, or domain semantics.
#################################################################

############################
# Superset Shape
############################

repac:SupersetShape
    a sh:NodeShape ;
    sh:targetClass repac:Superset ;
    sh:property [
        sh:path repac:name ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path repac:definition ;
        sh:minCount 1 ;
    ] .

############################
# Subset Shape
############################

repac:SubsetShape
    a sh:NodeShape ;
    sh:targetClass repac:Subset ;
    sh:property [
        sh:path repac:belongsToSuperset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

############################
# Set Shape
############################

repac:SetShape
    a sh:NodeShape ;
    sh:targetClass repac:Set ;
    sh:property [
        sh:path repac:belongsToSubset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

############################
# Element Shape
############################

repac:ElementShape
    a sh:NodeShape ;
    sh:targetClass repac:Element ;
    sh:property [
        sh:path repac:belongsToSet ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
