@prefix repac: <https://repac.org/ontology#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:  <http://purl.org/vocab/vann/> .

<https://repac.org/ontology>
    a owl:Ontology ;
    dcterms:title "REPAC Ontology"@en ;
    dcterms:description "Formal ontology for the REPAC Framework."@en ;
    vann:preferredNamespacePrefix "repac" ;
    vann:preferredNamespaceUri "https://repac.org/ontology#" ;
    owl:versionIRI <https://repac.org/ontology/0.1.0> ;
    owl:versionInfo "0.1.0"^^xsd:string .

repac:Superset
    a owl:Class ;
    rdfs:label "Superset"@en ;
    rdfs:comment "Top-level structural grouping construct in the REPAC Framework."@en .
